# Netlify DB connection string (Netlify sets this automatically on the live site).
# For local dev, get it with the Netlify CLI: netlify database connect --json
NETLIFY_DB_URL=
PORT=3001

# Apple Wallet (optional). Needs an Apple Developer Pass Type ID certificate.
# Certs can be PEM text, base64 of the PEM, or left blank and placed in certs/signerCert.pem, certs/signerKey.pem, certs/wwdr.pem
PASS_TYPE_ID=
APPLE_TEAM_ID=
PASS_ORG_NAME=
PASS_SIGNER_CERT=
PASS_SIGNER_KEY=
PASS_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
